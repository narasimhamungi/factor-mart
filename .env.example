# Snowflake - key-pair authentication
# (Snowflake announced it would block single-factor password sign-in from November 2025.)
SNOWFLAKE_ACCOUNT=ORG-ACCOUNT
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_PRIVATE_KEY_FILE=C:\path\to\rsa_key.p8
# Only if the private key is encrypted:
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=FACTOR_MART_WH
SNOWFLAKE_DATABASE=FACTOR_MART
SNOWFLAKE_SCHEMA=CORE
